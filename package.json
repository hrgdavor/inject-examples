{
  "name": "@hrg/inject-examples",
  "version": "1.1.0",
  "description": "Keep Markdown examples in sync with the real files they show — inject file content, or one region of it, into the fenced block that follows a link.",
  "keywords": [
    "markdown",
    "readme",
    "documentation",
    "docs",
    "examples",
    "fixtures",
    "inject",
    "sync",
    "cli",
    "region",
    "gitignore"
  ],
  "license": "MIT",
  "author": "Davor Hrg",
  "repository": {
    "type": "git",
    "url": "https://github.com/hrgdavor/inject-examples"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cli.mjs": "./cli.mjs",
    "./lib/section.mjs": "./lib/section.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "inject-examples": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "index.mjs",
    "README.md",
    "LICENSE",
    "lib",
    "src/js/scanner",
    "doc/section-matching.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test.mjs && node tools/section-vectors.mjs --check",
    "vectors": "node tools/section-vectors.mjs",
    "oracle": "node tools/mask-oracle.mjs",
    "compare:zig": "node tools/compare-zig.mjs",
    "demo": "bun tools/build-demo.mjs",
    "demo:check": "bun tools/build-demo.mjs --check"
  },
  "devDependencies": {
    "highlight.js": "^11.12.0"
  }
}
